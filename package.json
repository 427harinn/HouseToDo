{
  "name": "house-to-do",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:e2e": "playwright test",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "marketing:seed": "node scripts/marketing-seed.mjs",
    "marketing:capture:screenshots": "npm run marketing:seed && playwright test --config=playwright.marketing.config.ts --grep \"six unmodified\"",
    "marketing:capture:screenshots:additional": "npm run marketing:seed && playwright test --config=playwright.marketing.config.ts --grep \"additional major\"",
    "marketing:capture:videos": "npm run marketing:seed && playwright test --config=playwright.marketing.config.ts --grep \"390x844 Playwright video\"",
    "marketing:videos:duration": "node scripts/marketing-video-duration.mjs",
    "marketing:capture:all": "npm run marketing:seed && playwright test --config=playwright.marketing.config.ts",
    "marketing:appstore:render": "node marketing/app-store/final/renderer/render.mjs",
    "marketing:appstore:preview": "node marketing/app-store/final/renderer/render.mjs --preview-only",
    "marketing:appstore:render:base": "node marketing/app-store/final/renderer/render.mjs --base",
    "marketing:appstore:preview:base": "node marketing/app-store/final/renderer/render.mjs --base --preview-only",
    "marketing:key-visual:render": "node marketing/app-store/key-visual/renderer/render.mjs",
    "pwa:icons:generate": "node scripts/generate-pwa-icon-assets.mjs",
    "pwa:icons:validate": "node scripts/validate-pwa-icon.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:dev": "wrangler dev --ip 0.0.0.0",
    "cf:whoami": "wrangler whoami",
    "cf:deploy:staging:dry-run": "wrangler deploy --env staging --dry-run",
    "cf:validate:staging": "node scripts/validate-staging-config.mjs",
    "cf:d1:migrations:list:staging:remote": "wrangler d1 migrations list DB --env staging --remote",
    "cf:d1:migrations:apply:staging:remote": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:local": "wrangler d1 migrations apply house-to-do --local",
    "db:migrate:remote": "wrangler d1 migrations apply house-to-do --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.5.2",
    "lucide-react": "^1.34.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "wrangler": "4.114.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260722.1",
    "@eslint/js": "9.30.1",
    "@fontsource/yomogi": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.30.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.35.1",
    "vitest": "3.2.7"
  }
}
