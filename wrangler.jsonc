{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "house-to-do",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-21",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*", "/.well-known/*", "/mcp"]
  },
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5174,http://localhost:5174,http://app:5173,http://web:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "house-to-do",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "house-to-do-attachments"
    }
  ],
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  "env": {
    "staging": {
      "name": "house-to-do-staging",
      "workers_dev": true,
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "vars": {
        "APP_ENV": "staging",
        "ALLOWED_ORIGINS": "https://house-to-do-staging.427harinn.workers.dev",
        "OAUTH_ISSUER_URL": "https://house-to-do-staging.427harinn.workers.dev"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "house-to-do-staging",
          "database_id": "17e73ab2-78e1-4e18-87d4-21a4ccef3216",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "house-to-do-attachments-staging"
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    },
    "production": {
      "name": "house-to-do",
      "workers_dev": true,
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_ORIGINS": "https://house-to-do.427harinn.workers.dev",
        "OAUTH_ISSUER_URL": "https://house-to-do.427harinn.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "house-to-do",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "house-to-do-attachments"
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    }
  }
}
