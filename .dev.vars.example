# Local Worker development secrets. Copy this file to .dev.vars and fill values locally.
# Never commit .dev.vars.

# SESSION_SECRET: secret used to sign session cookies.
SESSION_SECRET=

# Comma-separated origins allowed to send cookie-authenticated state-changing API requests.
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://app:5173,http://web:5173

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
